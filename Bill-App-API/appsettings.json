{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JWT": {
    "Issuer": "bill-app",
    "Audience": "bill-app",
    "DurationInMinutes": 15
  },
  "RefreshToken": {
    "DurationInDays": 7,
    "OldTokenGraceInSeconds": 15
  },
  "Device": {
    "MaxDevice": 5
  },
  "SMTP": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "Bill App"
  },
  "LoginRateLimit": {
    "IP": 20,
    "Email": 5,
    "TtlMinutes": 15
  },
  "UserCache": {
    "TtlInHours": 24
  },
  "UserVerifyEmailCache": {
    "TtlInHours": 1
  }
}
